# Fluxeaze frontend — environment template.
# Copy to .env.local for local development:  cp .env.example .env.local
# NEVER commit real credentials. This file contains no secrets.

# Backend REST API base URL (browser-visible; must be an absolute URL).
# Local backend: http://localhost:4000/api/v1  |  Frontend: http://localhost:3000
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000/api/v1

# API transport: "contract" (generated OpenAPI client) or "mock"
# (deterministic in-memory fixtures for LOCAL DEV/TEST ONLY, with a visible
# banner; assumed shapes in BACKEND_INTEGRATION_REPORT.md).
#
# Leave this unset for the default behaviour:
#   - NEXT_PUBLIC_API_BASE_URL set   -> "contract" (real backend)
#   - no backend URL configured      -> "mock" (demo mode, so a fresh
#                                       checkout/preview is usable)
# Set it explicitly only when you need to force a transport.
# NEVER set "mock" for a production deployment.
# NEXT_PUBLIC_API_TRANSPORT=contract

# Public site URL used for metadata/sitemap/robots (no trailing slash needed).
# NEXT_PUBLIC_SITE_URL=https://app.fluxeaze.com
