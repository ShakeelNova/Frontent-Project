{
  "name": "@fluxeaze/frontend",
  "version": "0.1.0",
  "private": true,
  "description": "Fluxeaze frontend — Next.js 16 App Router, React 19, TypeScript (strict), Tailwind CSS 4",
  "scripts": {
    "dev": "next dev --port 3000",
    "build": "next build",
    "start": "next start --port 3000",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "api:types": "openapi-typescript ../../packages/api-contract/openapi.yaml --output src/api/generated.ts",
    "api:check": "node scripts/api-check.mjs"
  },
  "dependencies": {
    "@hookform/resolvers": "^6.0.0",
    "@tanstack/react-query": "^5.90.5",
    "next": "16.4.3",
    "openapi-fetch": "^0.17.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-hook-form": "^7.66.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.57.0",
    "@tailwindcss/postcss": "^4.1.17",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^24.10.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.1.1",
    "eslint": "^9.39.1",
    "eslint-config-next": "16.4.3",
    "jsdom": "^27.2.0",
    "openapi-typescript": "^7.10.1",
    "tailwindcss": "^4.1.17",
    "typescript": "^5.9.3",
    "vitest": "^4.0.8"
  }
}
